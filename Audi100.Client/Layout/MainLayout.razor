@inherits LayoutComponentBase

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu /> 
    </div>

    <main>
        <div class="top-row px-4">
            <a href="javascript:void(0)" @onclick="Logout">Cerrar sesión</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private int UserRole = 0;

    protected override async Task OnInitializedAsync()
    {
        var role = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "role");
        if (int.TryParse(role, out var parsedRole))
        {
            UserRole = parsedRole;
        }
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "token");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "role");
        NavigationManager.NavigateTo("/");
    }
}
