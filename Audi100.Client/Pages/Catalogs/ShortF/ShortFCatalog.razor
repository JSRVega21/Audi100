@page "/ShortFCatalog"
@inject NavigationManager NavigationManager
@inject IService<ShortF, int> ShortFService

@using Audi100.Services
@using Audi100.Models

<h3>Catálogo de Hallazgo (con nombre corto)</h3>

<!-- Contenedor principal con margen superior -->
<div class="container mt-5">
    <div class="row">
        <!-- Columna izquierda - Formulario -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4>@(selectedReport?.ShortFId == 0 ? "Crear nuevo Hallazgo corto" : "Editar")</h4>
                    <EditForm Model="selectedReport" OnValidSubmit="SaveReport">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <DxFormLayout>
                            <DxFormLayoutGroup>
                                <DxFormLayoutItem Caption="Descripción">
                                    <ChildContent Context="formContext">
                                        <InputText id="description" class="form-control" @bind-Value="selectedReport.Description" />
                                    </ChildContent>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>
                        </DxFormLayout>

                        <button type="submit" class="btn dx-button">
                            @((selectedReport?.ShortFId == 0 ? "Guardar" : "Actualizar"))
                        </button>

                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Columna derecha - Tabla -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4>Lista de Hallazgo corto</h4>
                    @if (shortF != null && shortF.Any())
                    {
                        <DxGrid Data="@shortF" ColumnResizeMode="GridColumnResizeMode.NextColumn" TextWrapEnabled="false" ShowSearchBox="true"
                                ShowFilterRow="true" ShowGroupPanel="true">
                            <Columns>
                                <DxGridDataColumn Caption="Id Hallazgo" FieldName="@nameof(ShortF.ShortFId)" Width="95px" />
                                <DxGridDataColumn Caption="Descripción" FieldName="@nameof(ShortF.Description)" Width="350px" />
                                <DxGridCommandColumn Width="125px">
                                    <HeaderTemplate>
                                        <span>Acciones</span>
                                    </HeaderTemplate>
                                    <CellDisplayTemplate Context="commandContext">
                                        @if (commandContext.DataItem is ShortF ShortF)
                                        {
                                            <div class="d-flex justify-content-start">
                                                <DxButton Click="@(() => EditReport(ShortF))"
                                                          RenderStyle="ButtonRenderStyle.Warning"
                                                          CssClass="custom-button">
                                                    <img src="icons/EditFrom.svg" class="custom-icon" />
                                                </DxButton>
                                                &nbsp;
                                                <DxButton Click="@(() => ConfirmDelete(ShortF.ShortFId))"
                                                          RenderStyle="ButtonRenderStyle.Danger"
                                                          CssClass="custom-button">
                                                    <img src="icons/DeleteFrom.svg" class="custom-icon" />
                                                </DxButton>
                                            </div>
                                            @if (ShortFIdToDelete == ShortF.ShortFId && showConfirmDelete)
                                            {
                                                <div class="mt-2 alert alert-warning">
                                                    ¿Seguro que quieres eliminar este hallazgo?
                                                    <DxButton Click="@(() => DeleteReport(ShortF.ShortFId))" CssClass="btn btn-danger ml-2">
                                                        Sí
                                                    </DxButton>
                                                    <DxButton Click="@CancelDelete" CssClass="btn btn-secondary ml-2">
                                                        No
                                                    </DxButton>
                                                </div>
                                            }
                                        }
                                    </CellDisplayTemplate>
                                </DxGridCommandColumn>
                            </Columns>
                        </DxGrid>
                    }
                    else
                    {
                        <p>Cargando o no se encontraron hallazgos...</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private List<ShortF> shortF = new List<ShortF>();
    private ShortF selectedReport = new ShortF();
    private bool showConfirmDelete = false;
    private int ShortFIdToDelete = 0;

    protected override async Task OnInitializedAsync()
    {
    await LoadReports();
    }

    private async Task LoadReports()
    {
        shortF = (await ShortFService.GetListAsync()).ToList();
    }

    private async Task SaveReport()
    {
    if (selectedReport.ShortFId == 0)
    {
        await ShortFService.AddAsync(selectedReport);
    }
    else
    {
        await ShortFService.UpdateAsync(selectedReport);
    }

    await LoadReports();
    ClearForm();
    }

    private async Task DeleteReport(int reportId)
    {
    await ShortFService.DeleteAsync(reportId);
    await LoadReports();
    CancelDelete();
    }

    private void EditReport(ShortF report)
    {
    selectedReport = report;
    }

    private void ClearForm()
    {
    selectedReport = new ShortF();
    }

    private void ConfirmDelete(int ShortFId)
    {
    ShortFIdToDelete = ShortFId;
    showConfirmDelete = true;
    }

    private void CancelDelete()
    {
    showConfirmDelete = false;
    ShortFIdToDelete = 0;
    }
}
