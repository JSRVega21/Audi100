@page "/WeighingCatalog"
@inject NavigationManager NavigationManager
@inject IService<Weighing, int> WeighingService

@using Audi100.Services
@using Audi100.Models

<h3>Catálogo Ponderación</h3>

<!-- Contenedor principal con margen superior -->
<div class="container mt-5">
    <div class="row">
        <!-- Columna izquierda - Formulario -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4>@(selectedReport?.WeighingId == 0 ? "Crear nueva Ponderación" : "Editar")</h4>
                    <EditForm Model="selectedReport" OnValidSubmit="SaveReport">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <DxFormLayout>
                            <DxFormLayoutGroup>
                                <DxFormLayoutItem Caption="Descripción">
                                    <ChildContent Context="formContext">
                                        <InputText id="description" class="form-control" @bind-Value="selectedReport.Description" />
                                    </ChildContent>
                                </DxFormLayoutItem>
                            </DxFormLayoutGroup>
                        </DxFormLayout>

                        <button type="submit" class="btn dx-button">
                            @((selectedReport?.WeighingId == 0 ? "Guardar" : "Actualizar"))
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Columna derecha - Tabla -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4>Lista de Ponderación</h4>
                    @if (weighing != null && weighing.Any())
                    {
                        <DxGrid Data="@weighing" ColumnResizeMode="GridColumnResizeMode.NextColumn" TextWrapEnabled="false" ShowSearchBox="true">
                            <Columns>
                                <DxGridDataColumn Caption="Id Hallazgo" FieldName="@nameof(Weighing.WeighingId)" Width="95px" />
                                <DxGridDataColumn Caption="Descripción" FieldName="@nameof(Weighing.Description)" Width="350px" />
                                <DxGridCommandColumn Width="150px">
                                    <HeaderTemplate>
                                        <span>Acciones</span>
                                    </HeaderTemplate>
                                    <CellDisplayTemplate Context="commandContext">
                                        @if (commandContext.DataItem is Weighing Weighing)
                                        {
                                            <div class="d-flex justify-content-start">
                                                <DxButton Click="@(() => EditReport(Weighing))" CssClass="btn btn-warning ml-2">
                                                    Editar
                                                </DxButton>
                                                <DxButton Click="@(() => ConfirmDelete(Weighing.WeighingId))" CssClass="btn btn-danger ml-2">
                                                    Eliminar
                                                </DxButton>
                                            </div>
                                            @if (WeighingIdToDelete == Weighing.WeighingId && showConfirmDelete)
                                            {
                                                <div class="mt-2 alert alert-warning">
                                                    ¿Seguro que quieres eliminar este hallazgo?
                                                    <DxButton Click="@(() => DeleteReport(Weighing.WeighingId))" CssClass="btn btn-danger ml-2">
                                                        Sí
                                                    </DxButton>
                                                    <DxButton Click="@CancelDelete" CssClass="btn btn-secondary ml-2">
                                                        No
                                                    </DxButton>
                                                </div>
                                            }
                                        }
                                    </CellDisplayTemplate>
                                </DxGridCommandColumn>
                            </Columns>
                        </DxGrid>
                    }
                    else
                    {
                        <p>Cargando o no se encontraron hallazgos...</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Weighing> weighing = new List<Weighing>();
    private Weighing selectedReport = new Weighing();
    private bool showConfirmDelete = false;
    private int WeighingIdToDelete = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        weighing = (await WeighingService.GetListAsync()).ToList();
    }

    private async Task SaveReport()
    {
        if (selectedReport.WeighingId == 0)
        {
            await WeighingService.AddAsync(selectedReport);
        }
        else
        {
            await WeighingService.UpdateAsync(selectedReport);
        }

        await LoadReports();
        ClearForm();
    }

    private async Task DeleteReport(int reportId)
    {
        await WeighingService.DeleteAsync(reportId);
        await LoadReports();
        CancelDelete();
    }

    private void EditReport(Weighing report)
    {
        selectedReport = report;
    }

    private void ClearForm()
    {
        selectedReport = new Weighing();
    }

    private void ConfirmDelete(int WeighingId)
    {
        WeighingIdToDelete = WeighingId;
        showConfirmDelete = true;
    }

    private void CancelDelete()
    {
        showConfirmDelete = false;
        WeighingIdToDelete = 0;
    }
}