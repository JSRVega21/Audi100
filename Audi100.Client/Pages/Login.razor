@page "/"
@inherits LayoutComponentBase

@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="login-background">

    <div class="login-container">
        <h3 class="animated-title"></h3>

        <div class="form-group">
            <label for="identifier" class="animated-label">Usuario:</label>
            <input type="text" @bind="identifier" class="form-control animated-input" id="identifier" />
        </div>

        <div class="form-group">
            <label for="password" class="animated-label">Contraseña:</label>
            <input type="password" @bind="password" class="form-control animated-input" id="password" />
        </div>

        <button class="animated-button mt-3" @onclick="async () => await HandleLogin()">Iniciar Sesión</button>

        @if (!string.IsNullOrEmpty(loginError))
        {
            <div class="alert alert-danger mt-2 animated-alert">@loginError</div>
        }
    </div>
</div>


@code {
    private string identifier = string.Empty;
    private string password = string.Empty;
    private string? loginError;

    private async Task HandleLogin()
    {
        var isAuthenticated = await AuthService.Login(identifier, password);

        if (isAuthenticated)
        {
            NavigationManager.NavigateTo("/home");
        }
        else
        {
            loginError = "Credenciales incorrectas. Inténtalo de nuevo.";
        }
    }
}
