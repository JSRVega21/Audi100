@page "/AuditReportView"
@inject NavigationManager NavigationManager
@inject IService<AuditReport, int> AuditReportService

@using Audi100.Services
@using Audi100.Models
@using DevExpress.Blazor
@using DevExpress.Export

<h3>Control de informes</h3>

<div class="card">
    <div class="card-body">
        @if (auditReports != null && auditReports.Any()) 
        {
            <DxGrid @ref="Grid" Data="@auditReports" ColumnResizeMode="GridColumnResizeMode.NextColumn" TextWrapEnabled="false" ShowSearchBox="true">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditReportId)" Caption="Id Informe" Width="95px" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReportCode)" Caption="Código del Informe" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.PeriodString)" Caption="Perido" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.nomDepto)" Caption="Centro de costo" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.nomDivision)" Caption="Division" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.nomSeccion)" Caption="Seccion" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.nomCompleto)" Caption="Nombre Completo" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReviewPriority)" Caption="Prioridad" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReviewdateOf)" Caption="Fecha de revisió del" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReviewdateAt)" Caption="Fecha de revisión al" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.CreationDate)" Caption="Fecha de creación" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ModificationDate)" Caption="Fecha de modificación" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ExpectedDate)" Caption="Fecha prevista para iniciar" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.OriginOfTheReview)" Caption="Planificación del informe" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ClassificationId)" Caption="Clasificación de revisión" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.BscId)" Caption="Bsc Indicador" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReportDescription)" Caption="Descripción del informe" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReportTitle)" Caption="Título del informe" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.ReportDate)" Caption="Fecha del informe" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.Shortage)" Caption="Faltante por diferencias" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.CrossShortage)" Caption="Faltante por cruce de mercaderías" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.Excess)" Caption="Sobrante por diferencias" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.CrossExcess)" Caption="Sobrante por cruce de mercaderías" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.MissingInQ)" Caption="Diferencias en Qtz" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditorId1)" Caption="Auxilitar Auditor" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditorId2)" Caption="Auxilitar Auditor 2" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditorId3)" Caption="Administrador de unidad de auditoria:" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.EmployeeId1)" Caption="Responsable" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.EmployeeId2)" Caption="Responsable 2" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.EmployeeId3)" Caption="Responsable 3" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.Hours)" Caption="Horas" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.HoursInReviwe)" Caption="Total de horas en estar revisando" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.VariationOfHours)" Caption="Validación de horas reales" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditObservations)" Caption="Observaciones de responsables de unidad auditada" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditStatus)" Caption="ID Estado" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditReport.AuditStatusText)" Caption="Estado Seguimiento"  />
                    <DxGridSelectionColumn Width="60px" />
                    <DxGridCommandColumn Width="150px">
                        <HeaderTemplate>
                            <span>Acciones</span>
                        </HeaderTemplate>
                        <CellDisplayTemplate Context="commandContext">
                            @if (commandContext.DataItem is AuditReport auditReport)
                            {
                                <div class="d-flex justify-content-start">
                                    <DxButton Click="@(() => EditReport(auditReport.AuditReportId))"
                                              RenderStyle="ButtonRenderStyle.Warning"
                                              CssClass="custom-button">
                                        <img src="icons/EditFrom.svg" class="custom-icon" />
                                    </DxButton>
                                    &nbsp;
                                    <DxButton Click="@(() => ConfirmDelete(auditReport.AuditReportId))"
                                              RenderStyle="ButtonRenderStyle.Danger"
                                              CssClass="custom-button">
                                        <img src="icons/DeleteFrom.svg" class="custom-icon" />
                                    </DxButton>
                                </div>
                                @if (auditReportIdToDelete == auditReport.AuditReportId && showConfirmDelete)
                                {
                                    <div class="mt-2 alert alert-warning">
                                        ¿Seguro que quieres eliminar este Informe?
                                        <DxButton Click="@(() => DeleteReport(auditReport.AuditReportId))"
                                                  CssClass="btn btn-danger ml-2">
                                            Sí
                                        </DxButton>
                                        <DxButton Click="@CancelDelete" CssClass="btn btn-secondary ml-2">
                                            No
                                        </DxButton>
                                    </div>
                                }
                            }
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                </Columns>
                <ToolbarTemplate>
                    <DxToolbar>
                        <DxToolbarItem  Text="Ajuste de columnas" Click="Grid_FitWidths" RenderStyle="ButtonRenderStyle.Secondary"  />
                        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" Text="Selector de Columnas" RenderStyle="ButtonRenderStyle.Secondary" IconCssClass="grid-icon-column-chooser" Click="ColumnChooserButton_Click" CssClass="mx-1" />
                        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" Text="Descarga a Excel" Click="ExportXlsx_Click" BeginGroup="true" />
                    </DxToolbar>
                </ToolbarTemplate>
            </DxGrid>
        }
        else
        {
            <p>Cargando o no se encontraron informes...</p>
        }
    </div>
</div>

<br />

<DxButton Click="CreateReport" 
          RenderStyle="ButtonRenderStyle.Info"
          CssClass="custom-button">
    <img src="icons/PlusFrom.svg" class="custom-icon" />
</DxButton>

@code {
    List<AuditReport> auditReports = new List<AuditReport>();
    private bool showConfirmDelete = false;
    private int auditReportIdToDelete = 0;
    IGrid Grid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        auditReports = (await AuditReportService.GetListAsync()).ToList();
    }

    private void CreateReport()
    {
        NavigationManager.NavigateTo("/AuditReportForm");
    }

    private void EditReport(int auditReportId)
    {
        NavigationManager.NavigateTo($"/AuditReportForm/{auditReportId}");
    }

    private void ConfirmDelete(int auditReportId)
    {
        auditReportIdToDelete = auditReportId;
        showConfirmDelete = true;
    }

    private void CancelDelete()
    {
        showConfirmDelete = false;
        auditReportIdToDelete = 0;
    }

    private async Task DeleteReport(int auditReportId)
    {
        await AuditReportService.DeleteAsync(auditReportId);
        showConfirmDelete = false;
        auditReportIdToDelete = 0;
        await LoadReports();
        StateHasChanged();
    }

    async Task ExportXlsx_Click()
    {
        string fileName = $"Datos del Informe ({DateTime.Now})";
        bool exportSelected = Grid.SelectedDataItems.Count > 0;

        await Grid.ExportToXlsxAsync(fileName, new GridXlExportOptions()
            {
                ExportSelectedRowsOnly = exportSelected
            });
    }

    void ColumnChooserButton_Click()
    {
        Grid.ShowColumnChooser();
    }
    void Grid_FitWidths()
    {
        Grid.AutoFitColumnWidths();
    }
}
