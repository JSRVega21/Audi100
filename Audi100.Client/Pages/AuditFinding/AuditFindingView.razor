@page "/AuditFindingView"
@inject NavigationManager NavigationManager
@inject IService<AuditFinding, int> AuditFindingService
@inject IService<AuditReport, int> AuditReportService

@using Audi100.Services
@using Audi100.Models
@using DevExpress.Blazor
@using DevExpress.Export

<h3>Control de Hallazgos</h3>

<div class="card">
    <div class="card-body">
        @if (auditFindings != null && auditFindings.Any())
        {
            <DxGrid @ref="Grid" Data="@auditFindings" ColumnResizeMode="GridColumnResizeMode.NextColumn"
                    TextWrapEnabled="false" ShowSearchBox="true" ShowFilterRow="true" ShowGroupPanel="true">
                <Columns>
                    <DxGridDataColumn Caption="Id Hallazgo" FieldName="@nameof(AuditFinding.AuditFindingId)" Width="95px" />
                    <DxGridDataColumn Caption="Id informe" FieldName="@nameof(AuditFinding.AuditReportId)" Width="95px" />
                    <DxGridDataColumn Caption="Descripción del reporte" FieldName="@nameof(AuditFinding.DataReport)" />
                    <DxGridDataColumn Caption="Fecha del hallazgo" FieldName="@nameof(AuditFinding.DateCreate)" />
                    <DxGridDataColumn Caption="Título del hallazgo" FieldName="@nameof(AuditFinding.FindingTitle)" />
                    <DxGridDataColumn Caption="Número de hallazgo" FieldName="@nameof(AuditFinding.NumberOfFindings)" Visible="false" />
                    <DxGridDataColumn Caption="Nivel de hallazgo" FieldName="@nameof(AuditFinding.FindLevel)" Visible="false" />
                    <DxGridDataColumn Caption="Clasificación de ponderación" FieldName="@nameof(AuditFinding.WeightingClassification)" Visible="false" />
                    <DxGridDataColumn Caption="Hallazgo con nombre corto" FieldName="@nameof(AuditFinding.FindShortName)" Visible="false" />
                    <DxGridDataColumn Caption="Ponderación (-)" FieldName="@nameof(AuditFinding.NegativeWeighting)" Visible="false" />
                    <DxGridDataColumn Caption="Riesgo (-)" FieldName="@nameof(AuditFinding.NegativeRisk)" Visible="false" />
                    <DxGridDataColumn Caption="Poderación (+)" FieldName="@nameof(AuditFinding.PositiveWeighting)" Visible="false" />
                    <DxGridDataColumn Caption="Riesgo (+)" FieldName="@nameof(AuditFinding.PositiveRisk)" Visible="false" />
                    <DxGridDataColumn Caption="Autorizado para informe" FieldName="@nameof(AuditFinding.AuthorizedForReport)" Visible="false" />
                    <DxGridDataColumn Caption="Revisado por" FieldName="@nameof(AuditFinding.ReviewedBy)" Visible="false" />
                    <DxGridDataColumn Caption="Trabajo ejecutado por" FieldName="@nameof(AuditFinding.WorkExecutedBy)" Visible="false" />
                    <DxGridDataColumn Caption="Condición" FieldName="@nameof(AuditFinding.ConditionAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Criterio" FieldName="@nameof(AuditFinding.CriterionAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Fundamento" FieldName="@nameof(AuditFinding.BasisAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Causa" FieldName="@nameof(AuditFinding.CauseAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Efecto" FieldName="@nameof(AuditFinding.EffectAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Requerimiento de auditoría" FieldName="@nameof(AuditFinding.RequirementOfAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Plan de acción" FieldName="@nameof(AuditFinding.PlanOfActionAudit)" Visible="false" />
                    <DxGridDataColumn Caption="Detalle del hallazgo" FieldName="@nameof(AuditFinding.DetailFindingAudit)" Visible="false" />
                    <DxGridDataColumn Caption="ID Estado" FieldName="@nameof(AuditFinding.AuditStatus)" Visible="false" />
                    <DxGridDataColumn Caption="Estado Seguimiento" FieldName="@nameof(AuditFinding.AuditStatusText)" />
                    <DxGridSelectionColumn Width="60px" />
                    <DxGridCommandColumn Width="150px">
                        <HeaderTemplate>
                            <span>Acciones</span>
                        </HeaderTemplate>
                        <CellDisplayTemplate Context="commandContext">
                            @if (commandContext.DataItem is AuditFinding auditFinding)
                            {
                                <div class="d-flex justify-content-start">
                                    <DxButton Click="@(() => EditReport(auditFinding.AuditFindingId))"
                                              RenderStyle="ButtonRenderStyle.Warning"
                                              CssClass="custom-button">
                                        <img src="icons/EditFrom.svg" class="custom-icon" />
                                    </DxButton>
                                    &nbsp;
                                    <DxButton Click="@(() => ConfirmDelete(auditFinding.AuditFindingId))"
                                              RenderStyle="ButtonRenderStyle.Danger"
                                              CssClass="custom-button">
                                        <img src="icons/DeleteFrom.svg" class="custom-icon" />
                                    </DxButton>
                                </div>
                                @if (auditFindingIdToDelete == auditFinding.AuditFindingId && showConfirmDelete)
                                {
                                    <div class="mt-2 alert alert-warning">
                                        ¿Seguro que quieres eliminar este hallazgo?
                                        <DxButton Click="@(() => DeleteReport(auditFinding.AuditFindingId))" CssClass="btn btn-danger ml-2">
                                            Sí
                                        </DxButton>
                                        <DxButton Click="@CancelDelete" CssClass="btn btn-secondary ml-2">
                                            No
                                        </DxButton>
                                    </div>
                                }
                            }
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                </Columns>
                <ToolbarTemplate>
                    <DxToolbar>
                        <DxToolbarItem Text="Ajuste de columnas" Click="Grid_FitWidths" RenderStyle="ButtonRenderStyle.Secondary" />
                        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" Text="Selector de Columnas" RenderStyle="ButtonRenderStyle.Secondary" IconCssClass="grid-icon-column-chooser" Click="ColumnChooserButton_Click" CssClass="mx-1" />
                        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" Text="Descarga a Excel" Click="ExportXlsx_Click" BeginGroup="true" />
                    </DxToolbar>
                </ToolbarTemplate>
            </DxGrid>
        }
        else
        {
            <p>Cargando o no se encontraron hallazgos...</p>
        }
    </div>
</div>

<br />

<DxButton Click="CreateReport"
          RenderStyle="ButtonRenderStyle.Info"
          CssClass="custom-button">
    <img src="icons/PlusFrom.svg" class="custom-icon" />
</DxButton>

@code {
    private List<AuditFinding> auditFindings = new List<AuditFinding>();
    private List<AuditReport> auditReports = new List<AuditReport>();
    private bool showConfirmDelete = false;
    private int auditFindingIdToDelete = 0;
    IGrid Grid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
        await LoadAuditReports();
    }

    private async Task LoadReports()
    {
        auditFindings = (await AuditFindingService.GetListAsync()).ToList();
    }

    private async Task LoadAuditReports()
    {
        auditReports = (await AuditReportService.GetListAsync()).ToList(); 
    }

    private void CreateReport()
    {
        NavigationManager.NavigateTo("/AuditFindingForm");
    }

    private void EditReport(int auditFindingId)
    {
        NavigationManager.NavigateTo($"/AuditFindingForm/{auditFindingId}");
    }
    private void ConfirmDelete(int auditFindingId)
    {
        auditFindingIdToDelete = auditFindingId;
        showConfirmDelete = true;
    }

    private void CancelDelete()
    {
        showConfirmDelete = false;
        auditFindingIdToDelete = 0;
    }

    private async Task DeleteReport(int auditFindingId)
    {
        await AuditFindingService.DeleteAsync(auditFindingId);
        showConfirmDelete = false;
        auditFindingIdToDelete = 0;
        await LoadReports();
        StateHasChanged();
    }

    #region Functions
    async Task ExportXlsx_Click()
    {
        string fileName = $"Datos del hallazgo ({DateTime.Now})";
        bool exportSelected = Grid.SelectedDataItems.Count > 0;

        await Grid.ExportToXlsxAsync(fileName, new GridXlExportOptions()
            {
                ExportSelectedRowsOnly = exportSelected
            });
    }

    void ColumnChooserButton_Click()
    {
        Grid.ShowColumnChooser();
    }
    void Grid_FitWidths()
    {
        Grid.AutoFitColumnWidths();
    }
    #endregion

