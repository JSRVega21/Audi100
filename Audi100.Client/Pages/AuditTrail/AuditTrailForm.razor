@page "/AuditTrailForm/{AuditTrailId:int?}"
@inject NavigationManager NavigationManager
@inject IService<AuditTrail, int> AuditTrailService
@inject IHttpClientFactory HttpClientFactory
@inject SqlHomeService SqlHomeService
@inject HttpClient Http

@using System.Linq
@using Audi100.Services
@using Audi100.Models
@using DevExpress.Blazor

<EditForm Model="@AuditTrail" OnValidSubmit="HandleValidSubmit" Context="editFromContext">
    <h3>@(AuditTrailId.HasValue ? "Editar seguimiento de hallazgo" : "Crear seguimiento de hallazgo")</h3>

    <DataAnnotationsValidator />

    <DxFormLayout>
        <DxFormLayoutGroup Caption="Selección del hallazgo" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">
            <DxFormLayoutItem Caption="Información del hallazgo" ColSpanMd="12">
                @if (!AuditTrailId.HasValue)
                {
                    <DxComboBox Data="@auditComplete"
                                @bind-Value="selectedAuditFindingId"
                                ValueFieldName="@nameof(AuditComplete.AuditFindingId)"
                                TextFieldName="@nameof(AuditComplete.DisplayName)"
                                @bind-Value:after="LoadSelectedAudit"
                                SearchMode="@ListSearchMode.AutoSearch"
                                SearchFilterCondition="@ListSearchFilterCondition.Contains"
                                ListRenderMode="ListRenderMode.Virtual"
                                NullText="Seleccione">
                    </DxComboBox>
                }
                else
                {
                    <DxMaskedInput @bind-Value="@AuditTrail.DisplayName" NullText="Id de hallazgo" ReadOnly="true" />
                }
            </DxFormLayoutItem>

        </DxFormLayoutGroup>
    </DxFormLayout>

    <DxFormLayout>
        <DxFormLayoutGroup Caption="Detalle del hallazgo" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

            <DxFormLayoutItem Caption="" Visible="false">
                <DxMaskedInput @bind-Value="@AuditTrail.DisplayName" NullText="Id de hallazgo"  />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Id de informe:" ColSpanMd="4">
                <DxMaskedInput @bind-Value="@AuditTrail.AuditReportId" NullText="Id de informe" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Nivel de Hallazgo" ColSpanMd="4">
                <DxTextBox @bind-Text="@AuditTrail.FindLevel" NullText="Nivel de Hallazgo" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Código del informe" ColSpanMd="4">
                <DxMaskedInput @bind-Value="@AuditTrail.ReportCode" NullText="Código del informe" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Clasificación de ponderación:" ColSpanMd="4">
                <DxTextBox @bind-Text="@AuditTrail.WeightingClassification" NullText="Clasificación de ponderación" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Id de hallazgo" ColSpanMd="4">
                <DxMaskedInput @bind-Value="@AuditTrail.AuditFindingId" NullText="Id de hallazgo" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Hallazgo corto:" ColSpanMd="4">
                <DxTextBox @bind-Text="@AuditTrail.FindShortName" NullText="Hallazgo corto" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Número de hallazgos" ColSpanMd="12">
                <DxMaskedInput @bind-Value="@AuditTrail.NumberOfFindings" NullText="Número de hallazgos" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Centro de costo del informe:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.nomDepto" NullText="Centro de costo" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="División del informe:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.nomDivision" NullText="División" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Sección del informe:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.nomSeccion" NullText="Sección" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Centro de costo del hallazgo:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.AuditTrailCostCenter" NullText="Centro de costo" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="División del hallazgo:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.AuditTrailDepto" NullText="División" ReadOnly="true" />
            </DxFormLayoutItem>
             
            <DxFormLayoutItem Caption="Sección del hallazgo:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.AuditTrailSeccion" NullText="Sección" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Auditor:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.AuditorTrail" NullText="Auditor" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Responsable:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.EmployeeTrail" NullText="Responsable" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Responsable:" ColSpanMd="6">
                <DxTextBox @bind-Text="@AuditTrail.EmployeeTrail2" NullText="Responsable" ReadOnly="true" />
            </DxFormLayoutItem>

        </DxFormLayoutGroup>
    </DxFormLayout>

    <div class="row">
        <!-- Columna izquierda -->
        <div class="col-md-6">
            <DxFormLayout>
                <DxFormLayoutGroup Caption="Detalle del hallazgo escrito" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

                    <DxFormLayoutItem Caption="Hallazgo Detalle" ColSpanMd="12" >
                        <DxMemo @bind-Text="@AuditTrail.DetailFindingAudit" NullText="Hallazgo Detalle" 
                        ReadOnly="true" CssClass="h-100" Rows="20" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>
            </DxFormLayout>
        </div>

        <!-- Columna derecha -->
        <div class="col-md-6">
            <DxFormLayout>
                <DxFormLayoutGroup Caption="Detalle del hallazgo Q" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

                    <DxFormLayoutItem Caption="Faltante (-)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.NegativeWeighting" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Riesgo (-)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.NegativeRisk" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Sobrante (+)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.PositiveWeighting" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Riesgo (+)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.PositiveRisk" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>

            <DxFormLayout>
                <DxFormLayoutGroup Caption="Detalle del Seguimiento Q" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

                    <DxFormLayoutItem Caption="Faltante Corregido (-)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.AuditTrailNegativeWeighting" Mask="Q#,###,###,###0.##" NullText="Q0,000.00"/>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Riesgo Corregido (-)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.AuditTrailNegativeRisk" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Sobrante Corregido (+)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.AuditTrailPositiveWeighting" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Riesgo Corregido (+)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.AuditTrailPositiveRisk" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" />
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>

            <DxFormLayout>
                <DxFormLayoutGroup Caption="Totales Q" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

                    <DxFormLayoutItem Caption="Faltante Total(-)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.TotalNegativeWeighting" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Riesgo Total(-)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.TotalNegativeRisk" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Sobrante Total(+)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.TotalPositiveWeighting" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Riesgo (+)" ColSpanMd="6">
                        <DxMaskedInput @bind-Value="@AuditTrail.TotalPositiveRisk" Mask="Q#,###,###,###0.##" NullText="Q0,000.00" ReadOnly="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Calcular" @onclick="CalculateTotals" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>
            </DxFormLayout>
        </div>
    </div>

    <DxFormLayout>
        <DxFormLayoutGroup Caption="Seguimiento del hallazgo" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

            <DxFormLayoutItem Caption="Fecha inicial de seguimiento:" ColSpanMd="4">
                <DxDateEdit @bind-Date="@AuditTrail.DateCreate" NullText="DD/MM/YYYY" />
                <ValidationMessage For="@(() => AuditTrail.DateCreate)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Número de seguimiento" ColSpanMd="4">
                <DxMaskedInput @bind-Value="@AuditTrail.Line" Mask="##0"/>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Hallazgo Clasificación:" ColSpanMd="4">
                <DxTextBox @bind-Text="@AuditTrail.AuditTrailWeighting" NullText="Sobrante de mercadería" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Seguimiento del hallazgo" ColSpanMd="7">
                <DxMemo @bind-Text="@AuditTrail.AuditTrailFollow" NullText="Hallazgo Detalle" CssClass="h-100" Rows="10" />
                <ValidationMessage For="@(() => AuditTrail.AuditTrailFollow)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Estatus del seguimiento" ColSpanMd="5">
                <DxComboBox Data="@Status"
                            @bind-Value="AuditTrail.AuditStatus"
                            ValueFieldName="Key"
                            TextFieldName="Value"
                            NullText="Seleccionar"
                            @bind-Value:after="@(async () => SetStatusText(AuditTrail.AuditStatus))" />
                <ValidationMessage For="@(() => AuditTrail.AuditStatus)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Visible="false">
                <DxMaskedInput @bind-Value="@AuditTrail.AuditStatusText" />
            </DxFormLayoutItem>

        </DxFormLayoutGroup>
    </DxFormLayout>


    <DxFormLayout>
        <DxFormLayoutGroup Caption="Botones">
            <DxFormLayoutItem>
                <button type="submit" class="dx-button">
                    @(AuditTrailId.HasValue ? "Actualizar" : "Crear")
                </button>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Regresar" @onclick="GoBack" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    </DxFormLayout>
</EditForm>

@code {
    [Parameter] public int? AuditTrailId { get; set; }
    private AuditTrail AuditTrail = new AuditTrail();
    private List<AuditComplete> auditComplete { get; set; } = new List<AuditComplete>();
    private int? selectedAuditFindingId { get; set; }

    private List<CostCenterUnit> CostCenter { get; set; } = new List<CostCenterUnit>();
    private List<CostSeccion> Seccions { get; set; } = new List<CostSeccion>();
    private List<CostDivision> Division { get; set; } = new List<CostDivision>();

    private Dictionary<int, string> Status = new Dictionary<int, string>
    {
        {0, "Pendiente"},
        {1, "En seguimiento"},
        {2, "Finalizada"},
        {3, "No terminada"}
    };

    public int? AuditStatus { get; set; }
    public string? AuditStatusText { get; set; }

    protected override async Task OnInitializedAsync()
    {
        auditComplete = (await GetAuditComplete())
              .OrderByDescending(r => r.AuditReportId)
        .ToList();

        if (AuditTrailId.HasValue)
        {
            AuditTrail = await AuditTrailService.GetByKeyAsync(AuditTrailId.Value) ?? new AuditTrail();
            selectedAuditFindingId = AuditTrail.AuditFindingId; 
        }
        else
        {
            AuditTrail = new AuditTrail
                {
                    Line = 1,
                    AuditStatus = 0,
                    AuditStatusText = Status[0]
                };
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (AuditTrailId.HasValue)
            {
                await AuditTrailService.UpdateAsync(AuditTrail);
            }
            else
            {
                await AuditTrailService.AddAsync(AuditTrail);
            }
            NavigationManager.NavigateTo("/AuditTrailView");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar el informe: {ex.Message}");
        }
    }

    public async Task<IEnumerable<AuditComplete>> GetAuditComplete()
    {
        var query = $"api/SqlDataHome/GetAuditComplete";
        return await Http.GetFromJsonAsync<IEnumerable<AuditComplete>>(query);
    }

    private void SetStatusText(int? selected)
    {
        AuditTrail.AuditStatus = selected ?? 0;

        if (Status.TryGetValue(AuditTrail.AuditStatus.Value, out var text))
        {
            AuditTrail.AuditStatusText = text;
        }
        else
        {
            AuditTrail.AuditStatusText = string.Empty;
        }

        StateHasChanged();
    }

    private void GoBack() 
    {
        NavigationManager.NavigateTo("/AuditTrailView", forceLoad: false);
    }

    private void CalculateTotals()
    {
        AuditTrail.TotalPositiveWeighting = (AuditTrail.PositiveWeighting ?? 0) - (AuditTrail.AuditTrailPositiveWeighting ?? 0);
        AuditTrail.TotalNegativeWeighting = (AuditTrail.NegativeWeighting ?? 0) - (AuditTrail.AuditTrailNegativeWeighting ?? 0);
        AuditTrail.TotalPositiveRisk = (AuditTrail.PositiveRisk ?? 0) - (AuditTrail.AuditTrailPositiveRisk ?? 0);
        AuditTrail.TotalNegativeRisk = (AuditTrail.NegativeRisk ?? 0) - (AuditTrail.AuditTrailNegativeRisk ?? 0);

        StateHasChanged();
    }


    private async Task LoadSelectedAudit()
    {
        if (selectedAuditFindingId.HasValue)
        {
            var selectedAudit = auditComplete.FirstOrDefault(a => a.AuditFindingId == selectedAuditFindingId.Value);

            if (selectedAudit != null)
            {
                AuditTrail.DisplayName = selectedAudit.DisplayName;
                AuditTrail.AuditFindingId = selectedAudit.AuditFindingId;
                AuditTrail.AuditReportId = selectedAudit.AuditReportId;
                AuditTrail.ReportCode = selectedAudit.ReportCode;
                AuditTrail.nomDepto = selectedAudit.nomDepto;
                AuditTrail.nomDivision = selectedAudit.nomDivision;
                AuditTrail.nomSeccion = selectedAudit.nomSeccion;
                AuditTrail.NumberOfFindings = selectedAudit.NumberOfFindings;
                AuditTrail.DetailFindingAudit = selectedAudit.DetailFindingAudit;
                AuditTrail.FindLevel = selectedAudit.FindLevel;
                AuditTrail.WeightingClassification = selectedAudit.WeightingClassification;
                AuditTrail.FindShortName = selectedAudit.FindShortName;
                AuditTrail.NumberOfFindings = selectedAudit.NumberOfFindings;
                AuditTrail.PositiveWeighting = selectedAudit.PositiveWeighting;
                AuditTrail.NegativeWeighting = selectedAudit.NegativeWeighting; 
                AuditTrail.PositiveRisk = selectedAudit.PositiveRisk;
                AuditTrail.NegativeRisk = selectedAudit.NegativeRisk;
                AuditTrail.AuditTrailCostCenter = selectedAudit.AuditFindingCostCenter;
                AuditTrail.AuditTrailDepto = selectedAudit.AuditFindingDepto;
                AuditTrail.AuditTrailSeccion = selectedAudit.AuditFindingSeccion;
                AuditTrail.AuditorTrail = selectedAudit.AuditorFinding;
                AuditTrail.EmployeeTrail = selectedAudit.EmployeeFinding;
                AuditTrail.EmployeeTrail2 = selectedAudit.EmployeeFinding2;
            }

            StateHasChanged();
        }
    }
}
