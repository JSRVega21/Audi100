

@page "/AuditPrintView"
@inject NavigationManager NavigationManager
@inject IService<AuditPrint, int> AuditPrintService
@inject IService<AuditFinding, int> AuditFindingService
@inject IService<AuditReport, int> AuditReportService

@using Audi100.Services
@using Audi100.Models
@using DevExpress.Blazor
@using DevExpress.Export

<h3>Control de Actas</h3>

<div class="card">
    <div class="card-body">
        @if (AuditPrints != null && AuditPrints.Any())
        {
            <DxGrid @ref="Grid" Data="@AuditPrints" ColumnResizeMode="GridColumnResizeMode.NextColumn"
                    TextWrapEnabled="false" ShowSearchBox="true" ShowFilterRow="true" ShowGroupPanel="true">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.AuditPrintId)" Caption="Id Acta" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.ReportCode)" Caption="Codigo Informe" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.DisplayName)" Caption="Descripción del informe" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.AuditorId1)" Caption="Auditor a cargo" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.DateI)" Caption="Fecha acta" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.CostSeccionPrint)" Caption="Centro de Costo" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.DateE)" Caption="Fecha final" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.EmployeeId1)" Caption="Administrador" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.AuditorId1)" Caption="Auditor a cargo" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.EmployeeId2)" Caption="Bodeguero" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.AuditorId2)" Caption="Auditor" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.EmployeeId3)" Caption="Centro de Costo" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.AuditorId3)" Caption="Auditor 2" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.OtherEmployee)" Caption="Otro" Visible="false" />
                    <DxGridDataColumn FieldName="@nameof(AuditPrint.OtherEmployee2)" Caption="Otro 2" Visible="false" />
                    <DxGridSelectionColumn Width="60px" />
                    <DxGridCommandColumn Width="230px">
                        <HeaderTemplate>
                            <span>Acciones</span>
                        </HeaderTemplate>
                        <CellDisplayTemplate Context="commandContext">
                            @if (commandContext.DataItem is AuditPrint AuditPrint)
                            {
                                <div class="d-flex justify-content-start">

                                    <DxButton Click="@(() => Print(AuditPrint.AuditPrintId))" 
                                              RenderStyle="ButtonRenderStyle.Primary"
                                              CssClass="custom-button">
                                        <img src="icons/DocumentFrom.svg" class="custom-icon" />
                                    </DxButton>
                                    &nbsp;
                                    <DxButton Click="@(() => PrintShort(AuditPrint.AuditPrintId))"
                                              RenderStyle="ButtonRenderStyle.Primary"
                                              CssClass="custom-button">
                                        <img src="icons/DocumentShortFrom.svg" class="custom-icon" />
                                    </DxButton>
                                    &nbsp;
                                    <DxButton Click="@(() => EditReport(AuditPrint.AuditPrintId))"
                                              RenderStyle="ButtonRenderStyle.Warning"
                                              CssClass="custom-button">
                                        <img src="icons/EditFrom.svg" class="custom-icon" />
                                    </DxButton>
                                    &nbsp;
                                    <DxButton Click="@(() => ConfirmDelete(AuditPrint.AuditPrintId))"
                                              RenderStyle="ButtonRenderStyle.Danger"
                                              CssClass="custom-button">
                                        <img src="icons/DeleteFrom.svg" class="custom-icon" />
                                    </DxButton>
                                </div>

                                @if (AuditPrintIdToDelete == AuditPrint.AuditPrintId && showConfirmDelete)
                                {
                                    <div class="mt-2 alert alert-warning">
                                        ¿Seguro que quieres eliminar esta acta?
                                        <DxButton Click="@(() => DeleteReport(AuditPrint.AuditPrintId))"
                                                  CssClass="btn btn-danger ml-2">
                                            Sí
                                        </DxButton>
                                        <DxButton Click="@CancelDelete" CssClass="btn btn-secondary ml-2">
                                            No
                                        </DxButton>
                                    </div>
                                }
                            }
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                </Columns>
                <ToolbarTemplate>
                    <DxToolbar>
                        <DxToolbarItem Text="Ajuste de columnas" Click="Grid_FitWidths" RenderStyle="ButtonRenderStyle.Secondary" />
                        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" Text="Selector de Columnas" RenderStyle="ButtonRenderStyle.Secondary" IconCssClass="grid-icon-column-chooser" Click="ColumnChooserButton_Click" CssClass="mx-1" />
                        <DxToolbarItem Text="Excel" Click="ExportXlsx_Click" BeginGroup="true" />
                    </DxToolbar>
                </ToolbarTemplate>
            </DxGrid>
        }
        else
        {
            <p>Cargando o no se encontraron actas...</p>
        }
    </div>
</div>

<br/>

<DxButton Click="CreateReport"
    RenderStyle="ButtonRenderStyle.Info"
          CssClass="custom-button">
    <img src="icons/PlusFrom.svg" class="custom-icon" />
</DxButton>

@code {
    private List<AuditReport> auditReports = new List<AuditReport>();
    List<AuditPrint> AuditPrints = new List<AuditPrint>();
    private bool showConfirmDelete = false;
    private int AuditPrintIdToDelete = 0;
    private int ManualAuditPrintId; // ID para entrada manual
    IGrid Grid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
        await LoadAuditReports();
    }

    private async Task LoadReports()
    {
        AuditPrints = (await AuditPrintService.GetListAsync()).ToList();
    }

    private async Task LoadAuditReports()
    {
        auditReports = (await AuditReportService.GetListAsync()).ToList();
    }

    private void CreateReport()
    {
        NavigationManager.NavigateTo("/AuditPrintForm");
    }

    private void EditReport(int AuditPrintId)
    {
        NavigationManager.NavigateTo($"/AuditPrintForm/{AuditPrintId}");
    }

    private void Print(int AuditPrintId)
    {
        NavigationManager.NavigateTo($"/AuditReportPrint/{AuditPrintId}");
    }

    private void PrintShort(int AuditPrintId)
    {
        NavigationManager.NavigateTo($"/AuditReportPrintShort/{AuditPrintId}");
    }

    private void ConfirmDelete(int AuditPrintId)
    {
        AuditPrintIdToDelete = AuditPrintId;
        showConfirmDelete = true;
    }

    private void CancelDelete()
    {
        showConfirmDelete = false;
        AuditPrintIdToDelete = 0;
    }

    private async Task DeleteReport(int AuditPrintId)
    {
        await AuditPrintService.DeleteAsync(AuditPrintId);
        showConfirmDelete = false;
        AuditPrintIdToDelete = 0;
        await LoadReports();
        StateHasChanged();
    }

    async Task ExportXlsx_Click()
    {
        string fileName = $"Datos Acta ({DateTime.Now})";
        bool exportSelected = Grid.SelectedDataItems.Count > 0;

        await Grid.ExportToXlsxAsync(fileName, new GridXlExportOptions()
            {
                ExportSelectedRowsOnly = exportSelected
            });
    }
    void Grid_FitWidths()
    {
        Grid.AutoFitColumnWidths();
    }
    void ColumnChooserButton_Click()
    {
        Grid.ShowColumnChooser();
    }
}
