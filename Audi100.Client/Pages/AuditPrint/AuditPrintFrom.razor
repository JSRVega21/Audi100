@page "/AuditPrintForm/{AuditPrintId:int?}"
@inject NavigationManager NavigationManager

@inject IService<AuditFinding, int> AuditFindingService
@inject IService<AuditReport, int> AuditReportService
@inject IService<AuditPrint, int> AuditPrintService
@inject IHttpClientFactory HttpClientFactory

@inject SqlService SqlService
@inject HttpClient Http

@using System.Linq
@using Audi100.Services
@using Audi100.Models
@using DevExpress.Blazor


<EditForm Model="@AuditPrint" OnValidSubmit="HandleValidSubmit" Context="editFromContext">
    <!-- Encabezado -->
    <h3>@(AuditPrintId.HasValue ? "Editar Acta de Auditoría" : "Crear Acta de Auditoría")</h3>

    <DataAnnotationsValidator />

    <!-- Encabezado del acta-->
    <DxFormLayout>
        <DxFormLayoutGroup Caption="Encabezado del acta" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">
            <DxFormLayoutItem Caption="Código del informe" ColSpanMd="12">
                <DxComboBox Data="auditReport" @bind-Value="AuditPrint.AuditReportId"
                            ValueFieldName="@nameof(AuditReport.AuditReportId)"
                            TextFieldName="@nameof(AuditReport.DisplayName)"
                            @bind-Value:after="@(async () => SetReportCode(AuditPrint.AuditReportId))"
                            SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains"
                            ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione un informe">
                </DxComboBox>
            </DxFormLayoutItem>

            <DxFormLayoutItem Visible="false" >
                <DxMaskedInput @bind-Value="@AuditPrint.ReportCode" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Visible="false" >
                <DxMaskedInput @bind-Value="@AuditPrint.DisplayName" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Acta hora inicial:" ColSpanMd="4">
                <DxDateEdit @bind-Date="@AuditPrint.DateI"
                            NullText="DD/MM/YYYY HH:mm:ss"
                            DisplayFormat="dd dddd MMMM yyyy HH:mm:ss"
                            TimeSectionVisible="true"
                            ScrollPickerFormat="dddd MMMM yyyy HH:mm"
                            CssClass="cw-320"
                            InputId="deScrollPicker"/>
                <ValidationMessage For="@(() => AuditPrint.DateI)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Acta hora final:" ColSpanMd="4">
                <DxDateEdit @bind-Date="@AuditPrint.DateE"
                            NullText="DD/MM/YYYY HH:mm:ss"
                            DisplayFormat="dd dddd MMMM yyyy HH:mm:ss"
                            TimeSectionVisible="true"
                            ScrollPickerFormat="dddd MMMM yyyy HH:mm"
                            CssClass="cw-320"
                            InputId="deScrollPicker" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="A partir de la linea" ColSpanMd="4">
                <DxMaskedInput @bind-Value="@AuditPrint.Line"  NullText="###" />
            </DxFormLayoutItem>

        </DxFormLayoutGroup>
    </DxFormLayout>

    <DxFormLayout>
        <DxFormLayoutGroup Caption="Responsables" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

            <DxFormLayoutItem Caption="Administrador:" >
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.EmployeeId1" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione"/>
                <ValidationMessage For="@(() => AuditPrint.EmployeeId1)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Auditor a cargo:">
                <DxComboBox Data="Auditors" @bind-Value="AuditPrint.AuditorId1" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
                <ValidationMessage For="@(() => AuditPrint.AuditorId1)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Bodeguero:">
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.EmployeeId2" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione"  />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Auditor:">
                <DxComboBox Data="Auditors" @bind-Value="AuditPrint.AuditorId2" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Bodeguero:">
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.EmployeeId3" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Auditor:">
                <DxComboBox Data="Auditors" @bind-Value="AuditPrint.AuditorId3" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Otros:">
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.OtherEmployee" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Otros 2:">
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.OtherEmployee2" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Cargo otros:">
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.OtherEmployee3" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Cargo otros 2:">
                <DxComboBox Data="Employees" @bind-Value="AuditPrint.OtherEmployee4" ValueFieldName="@nameof(Employee.Name_Employee)"
                            TextFieldName="@nameof(Employee.Name_Employee)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Sección de costo" ColSpanMd="12">
                <DxComboBox Data="Seccions" @bind-Value="AuditPrint.CostSeccionPrint" ValueFieldName="@nameof(CostSeccion.NomSeccion)"
                            TextFieldName="@nameof(CostSeccion.NomSeccion)" SearchMode="@ListSearchMode.AutoSearch"
                            SearchFilterCondition="@ListSearchFilterCondition.Contains" ListRenderMode="ListRenderMode.Virtual"
                            NullText="Seleccione una sección de costo" />
                <ValidationMessage For="@(() => AuditPrint.CostSeccionPrint)" />
            </DxFormLayoutItem>

        </DxFormLayoutGroup>
    </DxFormLayout>

    <!-- Descripción del acta -->
    <DxFormLayout>
        <DxFormLayoutGroup Caption="Descripción del anta" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">

@*             <DxFormLayoutItem Caption="Personal de administración de la sucursal o área auditada y auditoría" ColSpanMd="12">
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12">
                <DxMemo @bind-Text="@AuditPrint.PersonalPart" />
            </DxFormLayoutItem> *@

            <DxFormLayoutItem Caption="PRIMERO: Tiempo y alcance de la auditoría" ColSpanMd="12">
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12">
                <DxMemo @bind-Text="@AuditPrint.Part1" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="SEGUNDO: Resumen de hallazgos; total y detalles" ColSpanMd="12">
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12">
                <DxMemo @bind-Text="@AuditPrint.Part2" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="TERCERO:" ColSpanMd="12">
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12">
                <DxMemo @bind-Text="@AuditPrint.Part3" />
            </DxFormLayoutItem>

@*             <DxFormLayoutItem Caption="CUARTO:" ColSpanMd="12">
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12">
                <DxMemo @bind-Text="@AuditPrint.Part4" />
            </DxFormLayoutItem> *@

        </DxFormLayoutGroup>
    </DxFormLayout>

    <DxFormLayout>
        <DxFormLayoutGroup>
            <DxFormLayoutItem>
                <button type="submit" class="dx-button">
                    @(AuditPrintId.HasValue ? "Actualizar" : "Crear")
                </button>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Regresar" @onclick="GoBack" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    </DxFormLayout>


</EditForm>

@code {

    #region Models
    public DateTimeOffset DateI { get; set; } = DateTimeOffset.Now;
    public DateTimeOffset DateE { get; set; } = DateTimeOffset.Now;
    #endregion

    #region List
    [Parameter] public int? AuditPrintId { get; set; }

    private AuditFinding AuditFinding = new AuditFinding();

    private AuditPrint AuditPrint = new AuditPrint
        {

            // PersonalPart = "En las instalaciones de , siendo las  del , con la presencia del Administrador: , el Auditor a cargo: , " +
            // "y otros colaboradores, se realizó la auditoría correspondiente.",

            Part1 = "Del 00 al 00 de [mes] de [año] se realizó auditoría [tipo] de [que lineas], en la [bodega] [], " +
            " para verificar que las existencias sean razonables y cumplimiento en la aplicación de procedimientos " +
            " y políticas institucionales en tiempo y forma.",

            Part2 = "Derivado de la auditoría realizada por el equipo de Auditoría " +
            " interna, se determinó que existen faltantes de mercadería por la cantidad de [], y sobrantes de mercaderías por la cantidad de []; " +
            " se deja constancia y detalles en informe de las deficiencias encontradas y requerimientos de Auditoría interna para las correcciones y sanciones que correspondan.",

            Part3 = "La administración de la sucursal a través del administrador es responsable de cumplir con los controles, " +
            " procedimientos y políticas institucionales; debe ejecutar las acciones correctivas a las deficiencias encontradas y prevenir que no ocurran a partir de esta auditoría.",

            // Part4 = "CUARTO: Siendo las horas, del día , no habiendo más que hacer constar, se da por concluída la reunión de Resultados de la Auditoría, enterados firmamos "
        };


    private List<AuditReport> auditReport { get; set; } = new List<AuditReport>();
    private List<Employee> Employees { get; set; } = new List<Employee>();
    private List<Employee> Auditors { get; set; } = new List<Employee>();
    private List<CostSeccion> Seccions { get; set; } = new List<CostSeccion>();

    #endregion

    // #region PersonalPart
    
    // private void UpdatePersonalPart()
    // {
    //     if (!string.IsNullOrEmpty(AuditPrint.CostSeccionPrint)
    //         && AuditPrint.DateI != null
    //         && !string.IsNullOrEmpty(AuditPrint.EmployeeId1) 
    //         && !string.IsNullOrEmpty(AuditPrint.AuditorId1)) 
    //     {
    //         AuditPrint.PersonalPart = $"En las instalaciones de {AuditPrint.CostSeccionPrint}, siendo las {AuditPrint.DateI:HH:mm} del {AuditPrint.DateI:dd/MM/yyyy}, " +
    //                                   $"con la presencia del Administrador: {AuditPrint.EmployeeId1}, el Auditor a cargo: {AuditPrint.AuditorId1}, " +
    //                                   $"y otros colaboradores, se realizó la auditoría correspondiente.";
    //         StateHasChanged(); 
    //     }
    // }
    // #endregion

    #region OnInitialized
    protected override async Task OnInitializedAsync()
    {
        auditReport = (await AuditReportService.GetListAsync()).ToList();
        Auditors = (await GetAuditor()).ToList();
        Employees = (await GetEmployee()).ToList();
        Seccions = (await GetSeccion()).ToList();

        if (AuditPrintId.HasValue)
        {
            AuditPrint = await AuditPrintService.GetByKeyAsync(AuditPrintId.Value) ?? new AuditPrint();
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (AuditPrintId.HasValue)
            {
                await AuditPrintService.UpdateAsync(AuditPrint);
            }
            else
            {
                await AuditPrintService.AddAsync(AuditPrint);
            }
            NavigationManager.NavigateTo("/AuditPrintView");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar el informe: {ex.Message}");
        }
    }

    #endregion

    #region Get
    public async Task<IEnumerable<Employee>> GetAuditor()
    {
        var query = $"api/SqlData/GetAudit";
        return await Http.GetFromJsonAsync<IEnumerable<Employee>>(query);
    }

    public async Task<IEnumerable<CostSeccion>> GetSeccion()
    {
        var query = $"api/SqlData/GetSeccion";
        return await Http.GetFromJsonAsync<IEnumerable<CostSeccion>>(query);
    }

    public async Task<IEnumerable<Employee>> GetEmployee()
    {
        var query = $"api/SqlData/GetEmployee";
        return await Http.GetFromJsonAsync<IEnumerable<Employee>>(query);
    }
    #endregion

    private void GoBack()
    {
        NavigationManager.NavigateTo("/AuditPrintView", forceLoad: false);
    }

    private void SetReportCode(int? selected)
    {
        AuditPrint.AuditReportId = selected ?? 0;

        var selectedObj = auditReport.FirstOrDefault(a => a.AuditReportId == (selected ?? 0));

        if (selectedObj != null)
        {
            AuditPrint.ReportCode = selectedObj.ReportCode;
            AuditPrint.DisplayName = selectedObj.DisplayName;
        }

        StateHasChanged();
    }
}