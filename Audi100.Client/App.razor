@using Audi100.Client.Pages
@using Audi100.Client.Layout

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (routeData.PageType == typeof(Login))
        {
            <Microsoft.AspNetCore.Components.RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.LoginLayout)" />
        }
        else
        {
            <Microsoft.AspNetCore.Components.RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        }
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <p role="alert">Página no encontrada.</p>
        </LayoutView>
    </NotFound>
</Router>
